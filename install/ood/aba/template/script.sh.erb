#!/usr/bin/env bash
# Launch the REAL ABA backend on this compute node, served on $host:$port and
# reverse-proxied by OOD at /rnode/$host/$port/.
#
# ABA_RUNTIME_DIR + ABA_ENVS_DIR (both PER-USER, under /groups/<group>/aba/users/<user>/)
# are set by before.sh.erb from site.yaml via aba-preflight. Only the frontend dist
# is per-session here (the proxy prefix differs each launch). If ABA_SIF is set
# (site.yaml image.sif) the backend runs FROM the image; otherwise from the
# bind-mounted repo + venv (dev / direct nodes).
[ -n "${ABA_OOD_DEBUG:-}" ] && set -x   # opt-in shell trace (ABA_OOD_DEBUG=1); off by default

# NON-SIF (dev/bare) lane repo + venv. NO personal path is baked into this shared
# template: the code+venv come from a promoted release (below) or, for a bare dev node
# with neither a SIF nor a release, from ABA_DEV_REPO / ABA_DEV_VENV set on the OOD app.
ABA="${ABA_DEV_REPO:-}"
VENV="${ABA_DEV_VENV:-}"
# Versioned-release resolution for the NON-SIF lane (misc/slim_sif_deploy.md):
# when the share carries a promoted release (releases/<id> or `current`), the session
# code — AND the venv, when the release ships an `env` component — come FROM the release
# payload, so pin-on-launch + atomic swap hold in the bare lane exactly as in the SIF lane.
if [ -z "${ABA_SIF:-}" ]; then
  _share="${ABA_SHARE:-/cluster/aba}"
  _rel="${ABA_RELEASE_ID:+${_share}/releases/${ABA_RELEASE_ID}}"
  [ -n "${_rel}" ] && [ ! -e "${_rel}" ] && _rel=""
  _rel="${_rel:-${_share}/current}"
  if [ -e "${_rel}/repo/backend" ]; then
    ABA="$(readlink -f "${_rel}/repo")"
    [ -x "${_rel}/env/aba-venv/bin/python" ] && VENV="$(readlink -f "${_rel}/env/aba-venv")"
    echo "ABA: session code from release $(basename "$(readlink -f "${_rel}")") at ${ABA}"
  fi
fi

# Re-home the session under the per-user runtime dir. If preflight failed to
# set one, say so and stop — exporting HOME="/.home" would crash the backend
# at import (unwritable root path) with a far less legible traceback.
if [ -z "${ABA_RUNTIME_DIR:-}" ]; then
  echo "ABA: ABA_RUNTIME_DIR is unset — preflight did not produce aba-env.sh (see preflight.log). Not launching."
  exit 1
fi
export HOME="${ABA_RUNTIME_DIR}/.home"; mkdir -p "$HOME"
# NB: do NOT hardcode a model here — that would override the bundle default
# (system_bundle/settings.yaml `default_model`) and any per-user Settings choice for
# EVERY session. ABA_MODEL is only forwarded if a site/user actually set it.

# ABA_HOME = the per-user store, incl. the refreshable OAuth token store
# ($ABA_HOME/oauth.json). Set explicitly so the OAuth auto-refresh tier activates.
export ABA_HOME="${ABA_HOME:-${HOME}/.aba}"; mkdir -p "$ABA_HOME"

# --- per-session SPA build: bake this session's OOD reverse-proxy prefix into a
# private writable copy (the dist ships /__OOD_PREFIX__/ placeholders). Source it
# from the image (SIF) or the bind-mounted repo.
if [ -n "${ABA_SIF:-}" ]; then
  apptainer exec --bind "${PWD}:${PWD}" "${ABA_SIF}" cp -r /opt/aba/frontend-dist "${PWD}/dist"
else
  cp -r "${ABA}/frontend/dist" "${PWD}/dist"
fi
find "${PWD}/dist" -type f \( -name '*.html' -o -name '*.js' -o -name '*.css' -o -name '*.svg' \) \
  -exec sed -i "s|__OOD_PREFIX__|rnode/${host}/${port}|g" {} +
export ABA_FRONTEND_DIST="${PWD}/dist"

echo "ABA: ${host}:${port} | runtime=${ABA_RUNTIME_DIR} | envs=${ABA_ENVS_DIR} | sif=${ABA_SIF:-none}"

# --- Clean shutdown: recursively kill uvicorn's WHOLE descendant tree on stop ---
# (the OOD wrapper only pkill -P's direct children, so kernels would orphan ->
# <defunct> zombies and the Slurm job hangs in CG). Scoped to THIS job's tree, so
# it's multi-user safe. graceful TERM first, then KILL any stragglers.
killtree() {                      # killtree <pid> <signal>
  local _pid="$1" _sig="$2" _c
  for _c in $(pgrep -P "$_pid" 2>/dev/null); do killtree "$_c" "$_sig"; done
  kill -"$_sig" "$_pid" 2>/dev/null || true
}

if [ -n "${ABA_SIF:-}" ]; then
  # --- run FROM the image (production: setuid apptainer on the node) ---
  # --containall so the host $HOME doesn't shadow the baked /opt; forward ABA's
  # resolved runtime env + bind the cluster scope mounts. The image's runscript
  # starts uvicorn on $ABA_PORT inside the container.
  # THE LAUNCH CONTRACT lives in aba_launch.sh (staged from template/ beside this
  # script) and is sourced by BOTH consumers: this card and the deployment gate
  # (aba-vbc/verify.sh). Everything the backend needs to see — the scope binds,
  # the env store, site.yaml `binds:`, the slim base, the session TMPDIR, the
  # deploy_injected forward list, the Slurm client/munge/NSS plumbing and the
  # host module system — is assembled there, once. Do NOT add a --bind or --env
  # here: a bind only this card has is a bind the gate cannot certify, which is
  # exactly how the two drifted apart. Card-specific below: the per-session SPA
  # dist and the port, both of which the shared forward list picks up from the
  # environment.
  binds=( --bind "${PWD}/dist" )
  envs=()
  export ABA_PORT="${port}"
  export ABA_LAUNCH_WORKDIR="${PWD}"
  # Refuse rather than launch a crippled session. This script does NOT set -e, so
  # a missing file would make `.` print a warning and carry on: aba_launch_args
  # would then be "command not found", and apptainer would start with the dist
  # bind alone — no share, no env store, no scheduler. The session would come up
  # and fail at everything, which is far harder to diagnose than not starting.
  if [ ! -f "${PWD}/aba_launch.sh" ]; then
    echo "ABA: the launch contract (aba_launch.sh) was not staged into ${PWD} — the card is incomplete. Not launching."
    exit 1
  fi
  . "${PWD}/aba_launch.sh"
  aba_launch_args
  _sess_tmp_cleanup="${ABA_LAUNCH_TMP_CLEANUP:-}"     # shutdown() below rm -rf's it

  apptainer run --containall "${binds[@]}" "${envs[@]}" "${ABA_SIF}" &
  UV=$!
else
  # --- run from the bind-mounted repo + venv (dev / direct nodes) ---
  if [ -z "${ABA}" ] || [ ! -x "${VENV}/bin/python" ]; then
    echo "ABA: non-SIF lane but no repo/venv resolved (ABA='${ABA}', VENV='${VENV}')."
    echo "     Set image.sif or image.release_root in site.yaml, or ABA_DEV_REPO + ABA_DEV_VENV"
    echo "     on the OOD app for a bare dev node. Not launching."
    exit 1
  fi
  export ABA_TOOLS_DIR="${ABA_TOOLS_DIR:-$(dirname "${VENV}")/envs/tools}"
  cd "${ABA}/backend"
  "${VENV}/bin/python" -m uvicorn main:app --host 0.0.0.0 --port "${port}" &
  UV=$!
fi

shutdown() {
  echo "ABA: shutting down (pid ${UV}) ..."
  killtree "$UV" TERM
  for _ in $(seq 1 8); do kill -0 "$UV" 2>/dev/null || break; sleep 1; done
  killtree "$UV" KILL
  # remove the per-session parallel-FS TMPDIR fallback (never $SLURM_TMPDIR — Slurm
  # owns that). Set only when we created it; the single EXIT trap makes this reliable.
  [ -n "${_sess_tmp_cleanup:-}" ] && rm -rf "${_sess_tmp_cleanup}"
}
trap shutdown TERM INT EXIT
wait "$UV"
