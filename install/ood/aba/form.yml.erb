<%-
  # ── Preflight at form-render time, driven by /cluster/aba/site.yaml ──
  # List ONLY the launching user's own unix groups that are ENROLLED in ABA —
  # i.e. /groups/<group>/aba carries the .aba-workspace marker (the SAME signal
  # aba_preflight gates on). Unenrolled groups are omitted so a user can't launch
  # a session preflight would just block. All paths come from site.yaml.
  require 'yaml'; require 'etc'; require 'json'
  # Deployment share root. deploy.sh rewrites this default for the site; an exported
  # ABA_SITE_CONFIG still wins.
  site_default = '/cluster/aba/site.yaml'
  site = (YAML.safe_load(File.read(ENV['ABA_SITE_CONFIG'] || site_default)) rescue nil) || {}
  gcfg = (site['scopes'] || {})['group'] || {}
  ucfg = (site['scopes'] || {})['user']  || {}
  # GPU field — shown unless the site disables it (`form: {gpu: false}`). On a cluster
  # with no GPU partition the checkbox only ever produces a --gres=gpu:1 submit failure.
  fcfg     = site['form'] || {}
  show_gpu = fcfg.key?('gpu') ? !!fcfg['gpu'] : true
  # ── Instance ladder + time menu (site.yaml `form:`) ──
  # Cores and RAM only mean anything against a node's core count and its
  # memory-per-core, so the SITE owns the ladder. The fallback below is
  # deliberately PORTABLE — 4 GB/core, a commodity ratio — so a bare
  # deployment still schedules; a site with fat nodes raises it in its own
  # config rather than here.
  # >>> instance-ladder fallback (byte-identical in submit.yml.erb, which
  #     resolves the SAME ladder to sbatch flags — a guard asserts the match)
  def_instances = [{'id' => 'light', 'label' => 'Light', 'cores' => 4,  'mem' => '16G'},
                   {'id' => 'heavy', 'label' => 'Heavy', 'cores' => 16, 'mem' => '64G'}]
  # <<< instance-ladder fallback
  instances = (fcfg['instances'].is_a?(Array) && !fcfg['instances'].empty?) ?
                fcfg['instances'] : def_instances
  def_walltimes = [{'label' => 'Short — 4 hours', 'seconds' => 14400},
                   {'label' => '12 hours',        'seconds' => 43200}]
  walltimes = (fcfg['walltimes'].is_a?(Array) && !fcfg['walltimes'].empty?) ?
                fcfg['walltimes'] : def_walltimes
  root_tmpl   = gcfg['root_path'] || '/groups/{group_dir}/aba'
  strip       = gcfg['strip_suffix'].to_s                 # strip a site suffix: unix group → folder
  ui          = site['ui_text'] || {}
  markers     = ['.aba-workspace', '.bundle', '.envs']    # == aba_preflight OURS_MARKERS
  me          = ENV['USER'] || (Etc.getpwuid(Process.uid).name rescue 'user')
  myhome      = ENV['HOME'] || (Dir.home rescue '/tmp')

  # {group_dir} = on-disk folder name (strip the site suffix); {group} = unix group name.
  gdir     = ->(g) { (strip != '' && g.end_with?(strip)) ? g[0...-strip.length] : g }
  grp_root = ->(g) { root_tmpl.gsub('{group_dir}', gdir.call(g)).gsub('{group}', g) }
  # The user's session $ABA_HOME for a group, mirroring aba_preflight: <state_dir>/.home/.aba.
  state_tmpl = ucfg['state_dir'] || (myhome + '/.aba/state')
  aba_home = ->(g) {
    sd = state_tmpl.gsub('{group_dir}', gdir.call(g)).gsub('{group}', g)
                   .gsub('{user}', me).gsub('{home}', myhome)
    File.join(sd, '.home', '.aba')
  }
  # A personal credential OVERRIDE is present iff the app persisted one to $ABA_HOME
  # (Settings → config.env key/token, or subscription → oauth.json, or legacy json).
  has_personal = ->(g) {
    h = aba_home.call(g)
    (File.exist?(File.join(h, 'oauth.json')) ||
     File.exist?(File.join(h, 'credentials.json')) ||
     (File.exist?(File.join(h, 'config.env')) &&
      File.read(File.join(h, 'config.env')) =~ /ANTHROPIC_API_KEY|CLAUDE_CODE_OAUTH_TOKEN/)) ? true : false
  } rescue ->(g) { false }

  user_groups = (Process.groups + [Process.gid]).uniq.map { |gid|
    (Etc.getgrgid(gid).name rescue nil) }.compact.sort     # the user's own groups (primary + supplementary)
  # Does this deployment run sessions in labs at all? Where it does, a launch
  # NEEDS an enrolled lab; where it does not, the Lab field has nothing to offer
  # and an empty value is exactly what preflight expects.
  gscope   = gcfg['enabled'] ? true : false
  # ENROLLED = the group's on-disk folder (strip suffix) carries an ABA marker.
  enrolled = gscope ? user_groups.select { |g|
    markers.any? { |m| (File.exist?(File.join(grp_root.call(g), m)) rescue false) } } : []
  lab_opts = enrolled.map { |g| ["#{g}  ✓", g] }            # VALUE stays the unix group name
  # NO ENROLLED LAB. The one option carries an EMPTY value and a label starting
  # with `refusal`, and a launch from it is refused before anything runs:
  # submit.yml.erb raises on an empty lab (the guarantee — OnDemand shows the
  # message on this form and submits nothing) and form.js greys out Launch on
  # this label (the visible half). Letting it through spent a Slurm allocation
  # to die as "ABA_RUNTIME_DIR is unset" (an admin, 2026-08-28).
  #
  # NAME THE LAB, not the user's groups. A real account carries dozens of
  # permission groups (VPN, licences, share ACLs) and the lab rarely sorts
  # first: this once listed the first six alphabetically and cut the lab off.
  # A lab is a group whose OWN folder exists — the directory root_path puts
  # under the group, which enrolment creates the ABA workspace inside. Primary
  # group first; any beyond three are counted, never dropped silently.
  refusal = '— not enrolled'                                # == REFUSAL in form.js
  if lab_opts.empty? && !gscope
    lab_opts = [["— none (this deployment does not use labs)", ""]]
  elsif lab_opts.empty?
    contact = ui['enroll_contact'] || 'your ABA admin'
    segs    = root_tmpl.split('/')
    at      = segs.index { |s| s.include?('{group_dir}') || s.include?('{group}') }
    lab_dir = ->(g) { segs[0..at].join('/').gsub('{group_dir}', gdir.call(g)).gsub('{group}', g) }
    primary = (Etc.getgrgid(Process.gid).name rescue nil)
    labs    = at ? (user_groups - [me]).select { |g| (File.directory?(lab_dir.call(g)) rescue false) } : []
    labs    = labs.partition { |g| g == primary }.flatten
    more    = labs.length > 3 ? " (+#{labs.length - 3} more)" : ''
    msg = case labs.length
          when 0 then "#{refusal}: none of your groups has a lab folder — ask #{contact}"
          when 1 then "#{refusal}: ask #{contact} to enrol #{labs[0]}"
          else        "#{refusal}: ask #{contact} to enrol one of #{labs.first(3).join(', ')}#{more}"
          end
    lab_opts = [[msg, ""]]
  end
  # The Lab help follows the case the form is in. The enrolled wording ("Your
  # enrolled ABA groups (✓)") describes options that are not there when none is
  # enrolled, so that case gets its own text, in red: this form cannot launch.
  # OnDemand renders help as Markdown, which passes inline HTML through; the
  # class is Bootstrap's, so the red is the dashboard's own.
  lab_help =
    if !gscope
      'This deployment does not run sessions in labs.'
    elsif enrolled.empty?
      "<strong class='text-danger'>" +
        (ui['form_not_enrolled'] || 'None of your groups is enrolled in ABA yet, so a session cannot start.').to_s +
        '</strong>'
    else
      (ui['form_intro'] || 'Your enrolled ABA groups (✓). Group not listed? Ask your admin to enroll it.').to_s
    end
  # Show the "reset to the group credential" checkbox ONLY when a personal override exists
  # (for some enrolled group). Fail-safe: any probe error → hidden (never breaks the form).
  show_reset = (enrolled.any? { |g| has_personal.call(g) } rescue false)
-%>
---
cluster: "dev-cluster"
form:
  - aba_lab
  - aba_instance
  - aba_walltime
<%- if show_gpu -%>
  - has_gpu
<%- end -%>
<%- if show_reset -%>
  - reset_credential
<%- end -%>
# Every string that can come from site.yaml is emitted with to_json. A JSON
# string is a valid YAML scalar, so a quote in a site's wording cannot end it
# early; spliced into "…" it did, and OnDemand showed an error page instead of
# the form.
attributes:
  aba_instance:
    widget: "select"
    label: "Instance"
    help: "Cores and memory for the session. The whole allocation is held for the full time limit, whether or not you are connected."
    options:
<%- instances.each do |i| -%>
      - <%= ["#{i['label']} — #{i['cores']} cores, #{i['mem']} RAM", i['id'].to_s].to_json %>
<%- end -%>
  # The FIRST option is what OnDemand preselects, so the shortest goes first.
  # A time limit cannot be raised once the job is running — only a Slurm
  # operator can do that — so this choice is a commitment. Hitting it costs
  # the live kernel, not the project: entities persist in the lab workspace
  # and a relaunch resumes them.
  aba_walltime:
    widget: "select"
    label: "Time limit"
    help: "The session is killed at this limit and cannot be extended once running. There is no idle timeout, so a session left open holds its cores and memory until it expires — close it when you are done."
    options:
<%- walltimes.each do |w| -%>
      - <%= [w['label'].to_s, w['seconds'].to_i.to_s].to_json %>
<%- end -%>
  aba_lab:
    widget: "select"
    label: "Lab"
<%- if gscope -%>
    # A hint to the browser, never the refusal itself: whether OnDemand passes
    # `required` through to a <select> is not visible from here. Only where labs
    # are required — elsewhere the empty value is legitimate.
    required: true
<%- end -%>
    help: <%= lab_help.to_json %>
    options:
<%- lab_opts.each do |label, val| -%>
      - <%= [label, val].to_json %>
<%- end -%>
  has_gpu:
    widget: "check_box"
    label: "Request a GPU"
  # No credential field: the group credential (set up in the group's ABA folder) is used by
  # default, and a user connects their OWN key/subscription in-session via Settings → Agent.
  # This box (shown only when you already have a personal credential saved) discards it so the
  # session uses the lab's shared credential instead. Unchecked = keep using your personal one.
  reset_credential:
    widget: "check_box"
    label: "Use the group credential (clear my personal key/subscription)"
    help: "You have a personal credential saved from a previous session. Check to discard it and use the lab's shared credential this session."
